# Copier ce fichier en « .env » à la racine du dépôt puis adapter les valeurs.
# Il est lu par docker compose.

# --- PostgreSQL ---
POSTGRES_USER=docflow
POSTGRES_PASSWORD=changez-ce-mot-de-passe
POSTGRES_DB=docflow

# --- Ollama (inférence locale) ---
# Depuis les conteneurs, « host.docker.internal » désigne la machine hôte.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# qwen2.5:7b recommandé (≈ 5 Go) ; llama3.2 pour les machines modestes (≈ 2 Go).
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=300

# --- OCR ---
OCR_LANGUAGES=fra+eng
OCR_DPI=300

# --- Limites ---
MAX_UPLOAD_MB=25
MAX_BATCH_FILES=50

# --- Ports publiés sur l'hôte ---
FRONTEND_PORT=8080
BACKEND_PORT=8000
